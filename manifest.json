{
    "manifest_version": 3,
    "name": "CRM Executive Dashboard",
    "version": "1.0",
    "description": "Adds an executive dashboard overlay to any CRM",
    "permissions": ["activeTab"],
    "action": {
      "default_icon": {
        "16": "images/icon16.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
      },
      "default_title": "CRM Executive Dashboard"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "css": ["styles.css"]
      }
    ],
    "web_accessible_resources": [
      {
        "resources": ["dashboard.html", "images/*"],
        "matches": ["<all_urls>"]
      }
    ]
  }